{
  "manifest": {
    "manifestVersion": 3,
    "id": "local.js",
    "name": "js",
    "version": "0.1.0",
    "description": "A Ceru Music v3 guest-adapter plugin",
    "dataSchemas": {
      "config": 1,
      "state": 1
    },
    "guestPolicy": {
      "maxDepth": 1,
      "allowedCapabilities": [
        "network.request"
      ],
      "networkScopeMode": "per-guest-user-approved",
      "allowNativeCode": false,
      "allowRemoteCodeExecution": false
    },
    "engines": {
      "hostApi": "^3.0.0",
      "logicRuntime": "ceru-js@1"
    },
    "entry": {
      "logic": {
        "activation": [
          "onCommand:hello"
        ],
        "module": "logic.main"
      },
      "views": [
        {
          "id": "settings",
          "kind": "web",
          "module": "view.settings"
        }
      ]
    },
    "provides": {
      "guestAdapters": [
        {
          "id": "example-script",
          "format": "example-script",
          "compatibilityProfile": "basic@1",
          "bootstrap": "guest.bootstrap",
          "runtime": "ceru-js@1",
          "projectableProtocols": [
            "music.resolve@1"
          ]
        }
      ],
      "actions": [
        {
          "id": "hello",
          "title": "Hello"
        }
      ]
    },
    "uses": {
      "permissions": [
        {
          "key": "guest-manage",
          "name": "guests.manage",
          "scope": {
            "parent": "self"
          },
          "reason": "管理用户批准的子插件",
          "optional": true
        },
        {
          "key": "guest-run",
          "name": "guests.run",
          "scope": {
            "parent": "self"
          },
          "reason": "运行已批准的子插件",
          "optional": true
        }
      ]
    },
    "ui": {
      "pages": [
        {
          "id": "settings",
          "title": "插件设置",
          "view": "settings",
          "mount": "settings"
        }
      ]
    }
  },
  "entries": {
    "logic.main": "src/index.js",
    "guest.bootstrap": "src/guest.js",
    "view.settings": "src/settings.js"
  },
  "resources": {},
  "output": "dist/plugin.js"
}
