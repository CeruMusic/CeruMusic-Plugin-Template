{
  "manifest": {
    "manifestVersion": 3,
    "id": "local.ts",
    "name": "ts",
    "version": "0.1.0",
    "description": "A Ceru Music v3 source plugin",
    "dataSchemas": {
      "config": 1,
      "state": 1
    },
    "engines": {
      "hostApi": "^3.0.0",
      "logicRuntime": "ceru-js@1"
    },
    "entry": {
      "logic": {
        "activation": [
          "onCommand:hello",
          "onProvider:catalog"
        ],
        "module": "logic.main"
      }
    },
    "provides": {
      "providers": [
        {
          "id": "catalog",
          "name": "ts",
          "protocols": [
            "music.search@1",
            "music.resolve@1",
            "music.lyrics@1"
          ],
          "icon": {
            "kind": "host",
            "name": "music-note"
          },
          "connectionMode": "none"
        }
      ],
      "actions": [
        {
          "id": "hello",
          "title": "Hello"
        }
      ]
    },
    "uses": {
      "permissions": []
    },
    "ui": {
      "homeSections": [
        {
          "id": "catalog-playlists",
          "title": "歌单",
          "kind": "playlists",
          "icon": {
            "kind": "host",
            "name": "library"
          },
          "providerIds": [
            "catalog"
          ]
        }
      ]
    }
  },
  "config": {
    "displayName": "Ceru Demo",
    "apiOrigin": "https://music.example.com",
    "sources": {
      "demo": {
        "name": "Demo Source",
        "qualities": [
          "320k",
          "flac"
        ]
      }
    },
    "previewUrl": ""
  },
  "entries": {
    "logic.main": "src/index.ts"
  },
  "resources": {},
  "output": "dist/plugin.js"
}
