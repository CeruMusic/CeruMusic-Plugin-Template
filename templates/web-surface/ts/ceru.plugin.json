{
  "manifest": {
    "manifestVersion": 3,
    "id": "local.ts",
    "name": "ts",
    "version": "0.1.0",
    "description": "A Ceru Music v3 web-surface plugin",
    "dataSchemas": {
      "config": 1,
      "state": 1
    },
    "engines": {
      "hostApi": "^3.0.0",
      "logicRuntime": "ceru-js@1"
    },
    "entry": {
      "logic": {
        "activation": [
          "onCommand:hello"
        ],
        "module": "logic.main"
      },
      "views": [
        {
          "id": "page",
          "kind": "web",
          "title": "插件页面",
          "presentation": {
            "kind": "drawer",
            "placement": "right",
            "size": 480
          },
          "lifecycle": {
            "openAction": "page.open",
            "closeAction": "page.close"
          },
          "module": "view.main"
        }
      ]
    },
    "provides": {
      "actions": [
        {
          "id": "hello",
          "title": "Hello"
        },
        {
          "id": "page.open",
          "title": "打开页面"
        },
        {
          "id": "page.close",
          "title": "关闭页面"
        }
      ]
    },
    "uses": {
      "permissions": []
    },
    "ui": {
      "pages": [
        {
          "id": "page",
          "group": "library",
          "title": "ts",
          "view": "page",
          "mount": "sidebar"
        },
        {
          "id": "settings",
          "title": "插件设置",
          "view": "page",
          "mount": "settings"
        }
      ],
      "slots": [
        {
          "id": "search-note",
          "slot": "search.source-selector.after",
          "mode": "append",
          "view": "page",
          "order": 10
        }
      ]
    }
  },
  "entries": {
    "logic.main": "src/index.ts",
    "view.main": "src/view.ts"
  },
  "resources": {},
  "output": "dist/plugin.js"
}
