{
  "manifest": {
    "manifestVersion": 2,
    "id": "local.ts",
    "name": "ts",
    "version": "0.1.0",
    "description": "A Ceru Music v2 web-surface plugin",
    "engines": {
      "hostApi": "^2.0.0",
      "logicRuntime": "ceru-js@1",
      "uiSchema": "^1.0.0"
    },
    "modules": {
      "logic": {
        "entry": "logic.main",
        "activation": [
          "onCommand:hello"
        ]
      },
      "surfaces": [
        {
          "id": "page",
          "kind": "web",
          "entry": "view.main",
          "title": "插件页面",
          "presentation": {
            "kind": "drawer",
            "placement": "right",
            "size": 480
          },
          "lifecycle": {
            "openAction": "page.open",
            "closeAction": "page.close"
          }
        }
      ]
    },
    "contributes": {
      "commands": [
        {
          "id": "hello",
          "title": "Hello",
          "action": "hello"
        },
        {
          "id": "page.open",
          "title": "打开页面",
          "action": "page.open"
        },
        {
          "id": "page.close",
          "title": "关闭页面",
          "action": "page.close"
        }
      ],
      "sidebarItems": [
        {
          "id": "page",
          "group": "library",
          "title": "ts",
          "view": "page"
        }
      ],
      "uiExtensions": [
        {
          "id": "search-note",
          "slot": "search.source-selector.after",
          "mode": "append",
          "view": "page",
          "order": 10
        }
      ],
      "settingsPages": [
        {
          "id": "settings",
          "title": "插件设置",
          "view": "page"
        }
      ]
    },
    "permissions": [],
    "dataSchemas": {
      "config": 1,
      "state": 1
    }
  },
  "entries": {
    "logic.main": "src/index.ts",
    "view.main": "src/view.ts"
  },
  "resources": {},
  "output": "dist/plugin.js"
}
