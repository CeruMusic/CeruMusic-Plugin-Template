{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ceru: dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "ceru",
        "pattern": {
          "regexp": "^CERU_ERROR (.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*$",
          "endsPattern": "^Electron debugger:"
        }
      }
    },
    {
      "label": "Ceru: typecheck",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": "$tsc",
      "group": "build"
    },
    {
      "label": "Ceru: build",
      "type": "npm",
      "script": "build",
      "problemMatcher": []
    }
  ]
}
