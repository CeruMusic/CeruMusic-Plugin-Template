{
  "manifest": {
    "manifestVersion": 2,
    "id": "local.js",
    "name": "js",
    "version": "0.1.0",
    "description": "A Ceru Music v2 importer plugin",
    "engines": {
      "hostApi": "^2.0.0",
      "logicRuntime": "ceru-js@1",
      "uiSchema": "^1.0.0"
    },
    "modules": {
      "logic": {
        "entry": "logic.main",
        "activation": ["onCommand:hello"]
      },
      "surfaces": [
        {
          "id": "settings",
          "kind": "schema",
          "entry": "schema.settings"
        }
      ]
    },
    "contributes": {
      "commands": [
        {
          "id": "hello",
          "title": "Hello",
          "action": "hello"
        },
        {
          "id": "prepare-import",
          "title": "预览导入",
          "action": "import.prepare"
        }
      ],
      "settingsPages": [
        {
          "id": "settings",
          "title": "导入预览",
          "view": "settings"
        }
      ]
    },
    "permissions": [],
    "dataSchemas": {
      "config": 1,
      "state": 1
    }
  },
  "entries": {
    "logic.main": "src/index.js"
  },
  "resources": {
    "schema.settings": {
      "path": "ui/settings.json",
      "type": "json"
    }
  },
  "output": "dist/plugin.js"
}
