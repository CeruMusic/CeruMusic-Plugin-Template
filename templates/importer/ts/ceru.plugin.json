{
  "manifest": {
    "manifestVersion": 2,
    "id": "local.ts",
    "name": "ts",
    "version": "0.1.0",
    "description": "A Ceru Music v2 importer plugin",
    "engines": {
      "hostApi": "^2.0.0",
      "logicRuntime": "ceru-js@1",
      "uiSchema": "^1.0.0"
    },
    "modules": {
      "logic": {
        "entry": "logic.main",
        "activation": ["onCommand:hello"]
      }
    },
    "contributes": {
      "commands": [
        {
          "id": "hello",
          "title": "打开歌单导入",
          "action": "hello"
        }
      ],
      "playlistImporters": [
        {
          "id": "text-list",
          "title": "从文本清单导入（演示）",
          "description": "复用宿主歌单导入窗口；每行一个标题",
          "placeholder": "输入标题，以逗号分隔"
        }
      ]
    },
    "permissions": [],
    "dataSchemas": {
      "config": 1,
      "state": 1
    }
  },
  "entries": {
    "logic.main": "src/index.ts"
  },
  "resources": {},
  "output": "dist/plugin.js"
}
