{
  "manifest": {
    "manifestVersion": 3,
    "id": "local.ts",
    "name": "ts",
    "version": "0.1.0",
    "description": "A Ceru Music v3 vue plugin",
    "dataSchemas": {
      "config": 1,
      "state": 1
    },
    "engines": {
      "hostApi": "^3.0.0",
      "logicRuntime": "ceru-js@1"
    },
    "entry": {
      "logic": {
        "activation": [
          "onCommand:hello"
        ],
        "module": "logic.main"
      },
      "views": [
        {
          "id": "page",
          "kind": "web",
          "module": "view.main"
        }
      ]
    },
    "provides": {
      "actions": [
        {
          "id": "hello",
          "title": "Hello"
        }
      ]
    },
    "uses": {
      "permissions": []
    },
    "ui": {
      "pages": [
        {
          "id": "page",
          "group": "library",
          "title": "ts",
          "view": "page",
          "mount": "sidebar"
        }
      ]
    }
  },
  "entries": {
    "logic.main": "src/index.ts",
    "view.main": "src/view.ts"
  },
  "resources": {},
  "output": "dist/plugin.js",
  "framework": "vue"
}
