{
  "schemaVersion": "1.0",
  "id": "settings",
  "root": {
    "type": "section",
    "title": "音乐库连接 demo",
    "children": [
      {
        "type": "text-input",
        "label": "服务器地址",
        "bind": "serverUrl"
      },
      {
        "type": "button",
        "label": "演示连接",
        "action": "connection.connect"
      },
      {
        "type": "text",
        "bind": "status"
      }
    ]
  }
}
