{
  "manifest": {
    "manifestVersion": 2,
    "id": "local.ts",
    "name": "ts",
    "version": "0.1.0",
    "description": "A Ceru Music v2 connected-library plugin",
    "engines": {
      "hostApi": "^2.0.0",
      "logicRuntime": "ceru-js@1",
      "uiSchema": "^1.0.0"
    },
    "modules": {
      "logic": {
        "entry": "logic.main",
        "activation": ["onCommand:hello", "onProvider:catalog"]
      },
      "surfaces": [
        { "id": "library", "kind": "native", "entry": "render.library" },
        {
          "id": "settings",
          "kind": "schema",
          "entry": "schema.settings"
        }
      ]
    },
    "contributes": {
      "commands": [
        { "id": "account.summary", "title": "账号状态", "action": "account.summary" },
        { "id": "render.library", "title": "渲染音乐库", "action": "render.library" },
        { "id": "library.open", "title": "打开原生歌单页", "action": "library.open" },
        { "id": "playlist.open", "title": "打开歌单", "action": "playlist.open" },
        { "id": "playlist.import", "title": "导入歌单", "action": "playlist.import" },
        { "id": "track.play", "title": "播放", "action": "track.play" },
        {
          "id": "hello",
          "title": "Hello",
          "action": "hello"
        },
        {
          "id": "connect",
          "title": "演示连接",
          "action": "connection.connect",
          "view": "settings"
        }
      ],
      "providers": [
        {
          "id": "catalog",
          "name": "ts",
          "protocols": ["music.search@1", "music.resolve@1", "music.playlists@1"],
          "icon": {
            "kind": "host",
            "name": "music-note"
          },
          "connectionMode": "multiple"
        }
      ],
      "playlistSections": [{ "id": "library", "title": "我的音乐库", "view": "library", "order": 0 }],
      "accountItems": [{ "id": "catalog", "title": "音乐库账号", "view": "settings", "action": "account.summary" }],
      "playlistImporters": [{ "id": "catalog", "title": "演示歌单", "providerId": "catalog" }],
      "settingsPages": [
        {
          "id": "settings",
          "title": "插件设置",
          "view": "settings"
        }
      ]
    },
    "permissions": [{ "key": "playback", "name": "player.control", "reason": "使用 Host 的播放器和队列播放音乐库歌曲" }],
    "dataSchemas": {
      "config": 1,
      "state": 1
    }
  },
  "entries": {
    "logic.main": "src/index.ts"
  },
  "resources": {
    "schema.settings": {
      "path": "ui/settings.json",
      "type": "json"
    }
  },
  "output": "dist/plugin.js"
}
