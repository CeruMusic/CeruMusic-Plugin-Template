{
  "manifest": {
    "manifestVersion": 3,
    "id": "local.js",
    "name": "js",
    "version": "0.1.0",
    "description": "A Ceru Music v3 connected-library plugin",
    "dataSchemas": {
      "config": 1,
      "state": 1
    },
    "engines": {
      "hostApi": "^3.0.0",
      "logicRuntime": "ceru-js@1"
    },
    "entry": {
      "logic": {
        "activation": [
          "onCommand:hello",
          "onProvider:catalog"
        ],
        "module": "logic.main"
      },
      "views": [
        {
          "id": "library",
          "kind": "native",
          "module": "render.library"
        },
        {
          "id": "settings",
          "kind": "web",
          "module": "view.settings"
        }
      ]
    },
    "provides": {
      "providers": [
        {
          "id": "catalog",
          "name": "js",
          "protocols": [
            "music.search@1",
            "music.resolve@1",
            "music.playlists@1"
          ],
          "icon": {
            "kind": "host",
            "name": "music-note"
          },
          "connectionMode": "multiple",
          "beforeSelect": "catalog.enter"
        }
      ],
      "importers": [
        {
          "id": "catalog",
          "title": "演示歌单",
          "providerId": "catalog"
        }
      ],
      "actions": [
        { "id": "catalog.enter", "title": "切入音乐库" },
        {
          "id": "account.summary",
          "title": "账号状态"
        },
        {
          "id": "render.library",
          "title": "渲染音乐库"
        },
        {
          "id": "library.open",
          "title": "打开原生歌单页"
        },
        {
          "id": "playlist.open",
          "title": "打开歌单"
        },
        {
          "id": "playlist.import",
          "title": "导入歌单"
        },
        {
          "id": "track.play",
          "title": "播放"
        },
        {
          "id": "hello",
          "title": "Hello"
        },
        {
          "id": "connection.visible",
          "title": "判断演示连接状态"
        },
        {
          "id": "connection.connect",
          "title": "演示连接",
          "view": "settings"
        }
      ],
      "accounts": [
        {
          "id": "catalog",
          "title": "音乐库账号",
          "multiple": true,
          "capabilities": ["profile", "likes", "playlists", "history", "recommend"],
          "loginMethods": [
            "form"
          ],
          "providers": [
            "catalog"
          ],
          "view": "settings"
        }
      ]
    },
    "uses": {
      "permissions": [
        {
          "key": "playback",
          "name": "player.control",
          "reason": "使用 Host 的播放器和队列播放音乐库歌曲"
        }
      ]
    },
    "ui": {
      "pages": [
        {
          "id": "connected",
          "title": "已连接的音乐库",
          "view": "library",
          "mount": "home-tab",
          "when": { "selectedSource": "catalog", "predicate": "connection.visible" }
        },
        {
          "id": "settings",
          "title": "插件设置",
          "view": "settings",
          "mount": "settings"
        },
        {
          "id": "library",
          "title": "我的音乐库",
          "view": "library",
          "order": 0,
          "mount": "playlist-section"
        }
      ]
    }
  },
  "entries": {
    "logic.main": "src/index.js",
    "view.settings": "src/settings.js"
  },
  "resources": {},
  "output": "dist/plugin.js"
}
